{
  "name": "calcul-colonnes",
  "private": true,
  "version": "6.17.2",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.server.json && tsc -p tsconfig.tests.json && vite build",
    "build:server": "rm -rf dist-server && esbuild server/index.ts --bundle --splitting --platform=node --format=esm --target=node22 --packages=external --outdir=dist-server && cp -r server/migrations dist-server/migrations",
    "start": "tsx server/index.ts",
    "maintenance": "tsx server/index.ts maintenance",
    "db:copy-to-postgres": "tsx server/copy-to-postgres.ts",
    "check:quiz": "tsx server/check-quiz.ts",
    "test:e2e": "playwright test",
    "vocab:import": "tsx server/vocab-import.ts",
    "characters:build": "tsx server/characters-build.ts",
    "quiz:import": "tsx server/quiz-import.ts",
    "quiz:flags": "tsx server/quiz-flags.ts",
    "check:vocab": "tsx server/check-vocab.ts",
    "check:discover": "tsx server/check-discover.ts",
    "check:physics": "tsx server/check-physics.ts",
    "test:e2e:postgres": "node -e \"if(!process.env.E2E_DATABASE_URL){console.error('set E2E_DATABASE_URL to a database that may be emptied');process.exit(2)}\" && playwright test",
    "check:astronomy": "tsx server/check-astronomy.ts",
    "check:biology": "tsx server/check-biology.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible-mono": "^5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13",
    "katex": "^0.19.0",
    "pg": "^8.23.1",
    "tsx": "^4.23.15"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.0.3"
  }
}
