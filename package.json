{
  "name": "calcul-colonnes",
  "private": true,
  "version": "4.3.0",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.server.json && tsc -p tsconfig.tests.json && vite build",
    "start": "tsx server/index.ts",
    "db:copy-to-postgres": "tsx server/copy-to-postgres.ts",
    "check:quiz": "tsx server/check-quiz.ts",
    "test:e2e": "playwright test",
    "vocab:import": "tsx server/vocab-import.ts",
    "check:vocab": "tsx server/check-vocab.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "concurrently": "^10.0.6",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible-mono": "^5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@hono/node-server": "^2.1.4",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.13",
    "katex": "^0.19.0",
    "pg": "^8.23.1",
    "tsx": "^4.23.15"
  }
}
