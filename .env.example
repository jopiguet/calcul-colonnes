# Copy to .env. Without DATABASE_URL the server uses the local SQLite file.
# Variables already set in the environment win over this file.

# ---------------------------------------------------------------- database

# Local SQLite file (created on first start).
SQLITE_PATH=./data/calcul-colonnes.sqlite

# Neon: paste the connection string from the Neon dashboard to switch to PostgreSQL,
# with sslmode=verify-full instead of sslmode=require (same check, no warning).
# DATABASE_URL=postgresql://CHANGE_ME:CHANGE_ME@CHANGE_ME.neon.tech/CHANGE_ME?sslmode=verify-full

# Port of the server (API, and the built app in production).
PORT=8787

# Interface to listen on. 127.0.0.1 behind a Cloudflare tunnel or a reverse
# proxy on the same machine; empty for all interfaces.
# HOST=127.0.0.1

# Maintenance (migrations, backfills, new vocabulary books, session purge) at
# startup: on by default, off on Cloud Run, where each release runs it once
# as a job (`npm run maintenance`). true or false to override.
# STARTUP_MAINTENANCE=true

# Log format: text, or json (one object per line, for Cloud Logging). Default:
# json on Cloud Run, text elsewhere.
# LOG_FORMAT=text

# Vocabulary books imported at startup, comma-separated: each book not yet on
# the server is imported once. Made from your own copies: see docs/vocabulary.md.
# VOCAB_FILE=./data/vocab-spanish.json,./data/vocab-german.json,./data/vocab-english.json

# ---------------------------------------------------------------- sign-in

# Address people type in their browser. Used for the provider redirect URIs and
# to refuse requests from other sites. With https://, cookies are Secure and
# named __Host-cc_session. Development with Vite: http://localhost:5173
PUBLIC_URL=http://localhost:8787

# Force Secure cookies on or off (default: on when PUBLIC_URL is https).
# COOKIE_SECURE=true

# Days a session lasts without use; each use extends it.
SESSION_DAYS=30

# open: anyone who reaches the app can create an account.
# closed: only the very first account; others sign in with methods added from it.
REGISTRATION=open

# Behind a reverse proxy (Caddy, nginx) or Cloudflare: read the client address
# from CF-Connecting-IP or X-Forwarded-For for rate limiting. Only when the
# server cannot be reached except through that proxy (see HOST).
TRUST_PROXY=false

# Sign-in and sign-up attempts allowed per client address in 15 minutes.
# AUTH_ATTEMPTS_PER_ADDRESS=100

# ---------------------------------------------------------------- providers
# Each provider is on when its client id and secret are set. Register this
# redirect URI with the provider:  <PUBLIC_URL>/api/auth/oauth/<id>/callback
# (id: google, microsoft, github, or OIDC_ID). See docs/authentication.md.

# Google — console.cloud.google.com › APIs & Services › Credentials › OAuth client ID (Web).
# GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=CHANGE_ME

# Microsoft — entra.microsoft.com › App registrations › New registration (Web).
# MICROSOFT_CLIENT_ID=CHANGE_ME
# MICROSOFT_CLIENT_SECRET=CHANGE_ME
# common (work and personal accounts), consumers, organizations, or a tenant id.
# MICROSOFT_TENANT=common

# GitHub — github.com › Settings › Developer settings › OAuth Apps.
# GITHUB_CLIENT_ID=CHANGE_ME
# GITHUB_CLIENT_SECRET=CHANGE_ME

# Any OpenID Connect provider (Keycloak, Authentik, Auth0, GitLab, Infomaniak…).
# OIDC_ISSUER=https://CHANGE_ME
# OIDC_CLIENT_ID=CHANGE_ME
# OIDC_CLIENT_SECRET=CHANGE_ME
# OIDC_ID=oidc
# OIDC_NAME=CHANGE_ME
# OIDC_SCOPES=openid email profile
# Set to false if the provider's "email_verified" cannot be relied on.
# OIDC_TRUST_EMAIL=true
