# Copy to .env. Without DATABASE_URL the server uses the local SQLite file.

# Local SQLite file (created on first start).
SQLITE_PATH=./data/calcul-colonnes.sqlite

# Neon: paste the connection string from the Neon dashboard to switch to PostgreSQL.
# DATABASE_URL=postgresql://CHANGE_ME:CHANGE_ME@CHANGE_ME.neon.tech/CHANGE_ME?sslmode=require

# Port of the server (API, and the built app in production).
PORT=8787
